# Copy to .env and adjust as needed.
#
# Local single-user development (default):
DATABASE_URL=sqlite:///app.db
#
# Hosted / multi-user (Postgres) — no code changes required, just swap the URL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/job_app_assistant
#
# --- LLM layer (extraction / matching / cover letters) -----------------------
# Active provider: Gemini on Vertex AI, authenticating with Application Default
# Credentials (no API key). One-time: `gcloud auth application-default login`.
# Callers name a tier (small / mid / strong), never a model; see app/llm/client.py.
LLM_PROVIDER=gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_SMALL=gemini-3.1-flash-lite   # quick-screen, extract, match, checks
GEMINI_MODEL_MID=gemini-3.8-flash          # orchestration, analysis
GEMINI_MODEL_STRONG=gemini-3.1-pro-preview # cover letters (preview model: may change)
# Gemini 3 thinking level per tier (minimal|low|medium|high). Thinking tokens bill
# as output, so this is the main cost lever. Defaults: low / medium / high.
# GEMINI_THINKING_SMALL=low
# GEMINI_THINKING_MID=medium
# GEMINI_THINKING_STRONG=high
LLM_RPM=8
# Spend caps (USD) live in profiles.preferences, not here: llm_daily_budget_usd
# ($5), llm_total_budget_usd ($200). mid/strong calls stop at the cap; small calls
# keep running. Every call is logged to the llm_usage table.
#
# Gemini via an API key instead of Vertex (only if the Cloud org allows keys):
# GEMINI_API_KEY=your-google-ai-studio-key   (and drop GOOGLE_GENAI_USE_VERTEXAI)
#
# Dormant fallbacks — kept working, not required. Put keys in .env, never here.
# OpenAI: LLM_PROVIDER=openai, OPENAI_API_KEY=..., OPENAI_MODEL_SMALL=gpt-5-nano,
#   OPENAI_MODEL_LETTER=gpt-5-mini (used for mid AND strong; shuts down 2026-12-11)
# Groq:   LLM_PROVIDER=groq, GROQ_API_KEY=..., GROQ_MODEL=... (no tool calling)
#
# --- Scraper proxy (REQUIRED for any scraping) -------------------------------
# MANDATORY before running the scraper. ALL scraper browser traffic is routed
# through this endpoint so the user's real IP is never exposed to Seek (see
# CLAUDE.md "Networking policy"). The scraper is FAIL-CLOSED: if PROXY_SERVER is
# unset, app/scraper/browser.py refuses to launch a browser at all.
# PROXY_USERNAME / PROXY_PASSWORD are optional (only if your proxy needs auth).
PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=your-proxy-user
# PROXY_PASSWORD=your-proxy-pass
